<Window x:Class="PsyDiagnostics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsyDiagnostics"
        Width="900"
        Height="600"
        Background="#FF1E1E28"
        Foreground="#FFF5F5F7"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1E1E28"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF323244"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF4E5DFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6572FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Background="#FF1E1E28">

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#FF1E1E28"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <TextBlock Text="{Binding TopBarTitle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FFF5F5F7"
                       FontSize="13"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Режим заключенный"
                        Style="{StaticResource ModeButtonStyle}"
                        Command="{Binding SwitchToPrisonerModeCommand}"/>

                <Button Content="—"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="Minimize_Click"/>

                <Button Content="□"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="Maximize_Click"/>

                <Button Content="×"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"/>
    </Grid>
</Window>