<Window x:Class="PsyDiagnostics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PsyDiagnostics.Views"
        Title="PsyDiagnostics"
        Height="600"
        Width="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF1E1E28"
        Foreground="#FFF5F5F7">

    <Grid Background="#FF1E1E28">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#FF1E1E28"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <TextBlock Text="{Binding TopBarTitle}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="#FFF5F5F7"
                       FontSize="13"/>

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right">

                <Button Content="Режим заключенный"
            Width="150"
            Height="32"
            Margin="0,0,8,0"
            Background="#FF4E5DFF"
            Foreground="White"
            BorderBrush="Transparent"
            Command="{Binding SwitchToPrisonerModeCommand}"/>

                <Button Content="—"
            Width="45"
            Height="32"
            Click="Minimize_Click"/>

                <Button Content="□"
            Width="45"
            Height="32"
            Click="Maximize_Click"/>

                <Button Content="×"
            Width="45"
            Height="32"
            Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"/>
    </Grid>
</Window>