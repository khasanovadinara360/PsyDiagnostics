<UserControl x:Class="PsyDiagnostics.Views.PsychologistLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E28">

    <UserControl.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FA4B5"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#323244"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0,40,0"/>
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#323244"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#4E5DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#323244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Width="420"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#252532"
                BorderBrush="#323244"
                BorderThickness="1"
                CornerRadius="15">

            <StackPanel>
                <TextBlock Text="Авторизация психолога"
                           Margin="0,0,0,25"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Логин"
                           Style="{StaticResource LabelTextStyle}"/>

                <TextBox Text="{Binding PsychologistLoginFullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,15"
                         Style="{StaticResource InputTextBoxStyle}"/>

                <TextBlock Text="Пароль"
                           Style="{StaticResource LabelTextStyle}"/>

                <Grid Margin="0,5,0,5">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource PasswordBoxStyle}"/>

                    <TextBox x:Name="VisiblePasswordBox"
                             Padding="10,0,40,0"
                             Visibility="Collapsed"
                             Style="{StaticResource InputTextBoxStyle}"/>

                    <Button x:Name="TogglePasswordButton"
                            Width="32"
                            Height="32"
                            Margin="0,0,3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            Cursor="Hand"
                            Content="👁"
                            Click="TogglePassword_Click"/>
                </Grid>

                <TextBlock Text="Минимум 8 символов, заглавная буква, цифра и спецсимвол"
                           Margin="0,0,0,10"
                           Foreground="#9FA4B5"
                           FontSize="11"/>

                <TextBlock Text="{Binding LoginError}"
                           Margin="0,0,0,10"
                           Foreground="{Binding LoginMessageColor}"
                           TextWrapping="Wrap"/>

                <Button Content="Войти"
                        Margin="0,0,0,10"
                        Click="Login_Click"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Content="Забыли пароль?"
                        Click="ResetPassword_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>