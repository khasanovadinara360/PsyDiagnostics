<UserControl x:Class="PsyDiagnostics.Views.ParticipantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PsyDiagnostics.Helpers"
             xmlns:paint="clr-namespace:LiveChartsCore.SkiaSharpView.Painting;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:skia="clr-namespace:SkiaSharp;assembly=SkiaSharp"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Focusable="True">

    <UserControl.Resources>

        <SolidColorBrush x:Key="BgMainColor" Color="#FF1E1E28"/>
        <SolidColorBrush x:Key="BgCardColor" Color="#FF252532"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF323244"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF4E5DFF"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#FF9FA4B5"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#FFFF5370"/>
        <helpers:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Единый стиль для всех полей ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Тёмный ComboBox -->
        <Style TargetType="ComboBox" x:Key="DarkComboBox">
            <EventSetter Event="PreviewMouseDoubleClick"
             Handler="ComboBox_DoubleClick"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Foreground="{StaticResource TextPrimaryColor}"
                           Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                    <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Margin="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryColor}"
                                     CaretBrush="{StaticResource TextPrimaryColor}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Visibility="Hidden"
                                     Focusable="True"/>

                                    <ToggleButton Grid.Column="1"
                                          x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{StaticResource TextPrimaryColor}"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="{StaticResource BgCardColor}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1">
                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox"
                                Property="Visibility"
                                Value="Visible"/>
                                <Setter TargetName="ContentSite"
                                Property="Visibility"
                                Value="Hidden"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20" Background="{StaticResource BgMainColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтрация -->
        <StackPanel Grid.Row="0"
                Visibility="{Binding PsychologistVisibility}">

            <!-- Поиск по ID -->
            <TextBlock Text="ID заключенного"
                   Foreground="{StaticResource TextSecondaryColor}"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">

                <TextBox Text="{Binding SearchId, UpdateSourceTrigger=PropertyChanged}"
             Width="200"
             Padding="6,0"
             Height="32"
             BorderBrush="{StaticResource AccentColor}"
             BorderThickness="1">

                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                        Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Content="Найти"
            Command="{Binding SearchCommand}"
            Margin="10,0,0,0"
            Padding="10,0"
            Height="32"
            Background="{StaticResource AccentColor}"
            BorderBrush="Transparent"/>

                <Button Content="Сохранить"
        Width="80"
        Margin="0,0,10,0"
        Command="{Binding SaveCommand}"/>

                <Button Content="Очистить"
        Width="90"
        Margin="0,0,10,0"
        Background="#323244"
        Foreground="White"
        BorderBrush="#323244"
        Command="{Binding ClearParticipantCommand}"/>

                <Button Content="Добавить тест"
        Width="120"
        Command="{Binding AddTestCommand}"/>
            </StackPanel>

            <!-- КНОПКА СВЕРНУТЬ ФИЛЬТРЫ -->
            <Button Content="Расширенный поиск"
                Command="{Binding ToggleFilterPanelCommand}"
                Width="180"
                Height="32"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
                Background="{StaticResource AccentColor}"
                BorderBrush="Transparent"/>

            <!-- Расширенный поиск -->
            <Border Background="#2A2A40"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterPanelVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="Расширенный поиск"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryColor}"
                           Margin="0,0,0,8"/>

                    <WrapPanel>

                        <!-- ФИО -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="ФИО"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <TextBox Text="{Binding SearchFio, UpdateSourceTrigger=PropertyChanged}"
             Width="220"
             Margin="0,3,6,3"
             Height="32"
             Padding="6,0"
             BorderBrush="{StaticResource AccentColor}"
             BorderThickness="1"/>
                        </StackPanel>

                        <!-- Гражданство -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Гражданство"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="150"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding CitizenshipValues}"
              SelectedItem="{Binding FilterCitizenship, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>
                        </StackPanel>

                        <!-- Город -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Город"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="150"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding Cities}"
              Text="{Binding FilterCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="True"
              IsTextSearchEnabled="True"
              StaysOpenOnEdit="True"/>
                        </StackPanel>

                        <!-- Возраст от -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Возраст от"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="90"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding AgeValues}"
              SelectedItem="{Binding AgeFromText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>
                        </StackPanel>

                        <!-- Возраст до -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Возраст до"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="90"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding AgeValues}"
              SelectedItem="{Binding AgeToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>
                        </StackPanel>

                        <!-- Статья / часть / пункт УК РФ -->
                        <StackPanel Margin="0,0,10,8" Width="270">

                            <DockPanel Margin="0,0,0,3">
                                <TextBlock Text="Статья УК РФ"
                   Foreground="{StaticResource TextSecondaryColor}"
                   VerticalAlignment="Center"/>

                                <Button Content="?"
                Width="22"
                Height="22"
                Margin="6,0,0,0"
                Padding="0"
                FontWeight="Bold"
                Background="{StaticResource AccentColor}"
                BorderBrush="Transparent"
                DockPanel.Dock="Right">
                                    <Button.ToolTip>
                                        <ToolTip MaxWidth="520"
             Placement="Mouse"
             Background="#2A2A40"
             Foreground="White"
             BorderBrush="{StaticResource AccentColor}"
             BorderThickness="1"
             Padding="10">

                                            <TextBlock Text="{Binding ArticleTooltipText}"
                   TextWrapping="Wrap"
                   Width="480"
                   FontSize="13"
                   LineHeight="20"/>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="77"/>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding Articles}"
                  Text="{Binding FilterArticle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>

                                <ComboBox Grid.Column="2"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ArticleParts}"
                  SelectedItem="{Binding FilterArticlePart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="False" Grid.ColumnSpan="2"/>

                                <ComboBox Grid.Column="5"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ArticlePoints}"
                  SelectedItem="{Binding FilterArticlePoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="False"/>
                            </Grid>

                            <TextBlock Text="статья / часть / пункт"
               FontSize="10"
               Foreground="{StaticResource TextSecondaryColor}"
               Margin="2,2,0,0"/>
                        </StackPanel>

                        <!-- Отряд -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Отряд"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="90"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding Units}"
              Text="{Binding FilterUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="True"
              IsTextSearchEnabled="True"
              StaysOpenOnEdit="True"/>
                        </StackPanel>

                        <!-- Риск -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Риск"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <ComboBox Width="110"
              Margin="0,3,6,3"
              Height="32"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding RiskValues}"
              SelectedItem="{Binding FilterRisk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>
                        </StackPanel>

                        <!-- Срок от -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Срок от"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="70"
                  Margin="0,3,4,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding TermNumberValues}"
                  Text="{Binding SentenceFromNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>

                                <ComboBox Width="95"
                  Margin="0,3,6,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding TermUnitValues}"
                  Text="{Binding SentenceFromUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Срок до -->
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Срок до"
               Foreground="{StaticResource TextSecondaryColor}"/>

                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="70"
                  Margin="0,3,4,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding TermNumberValues}"
                  Text="{Binding SentenceToNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>

                                <ComboBox Width="95"
                  Margin="0,3,6,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding TermUnitValues}"
                  Text="{Binding SentenceToUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="True"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"/>
                            </StackPanel>
                        </StackPanel>

                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,8">
                        <Button Content="Найти по фильтрам"
        Command="{Binding ExtendedSearchCommand}"
        Margin="0,3,6,3"
        Padding="10,0"
        Height="32"
        Background="{StaticResource AccentColor}"
        BorderBrush="Transparent"/>

                        <Button Content="Очистить"
            Command="{Binding ClearSearchFiltersCommand}"
            Margin="5,3,6,3"
            Padding="10,0"
            Height="32"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SearchMessage}"
           Foreground="{StaticResource ErrorColor}"
           FontWeight="SemiBold"
           Margin="0,8,0,0"/>

                    <!-- Таблица результатов поиска -->
                    <DataGrid ItemsSource="{Binding SearchResults}"
          SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
          SelectionUnit="FullRow"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          MaxHeight="180"
          Margin="0,8,0,0"
          Background="#1E1E28"
          Foreground="{StaticResource TextPrimaryColor}"
          BorderBrush="{StaticResource BorderColor}"
          BorderThickness="1"
          RowBackground="#252532"
          AlternatingRowBackground="#2A2A40"
          GridLinesVisibility="None"
          HorizontalGridLinesBrush="{StaticResource BorderColor}"
          VerticalGridLinesBrush="{StaticResource BorderColor}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252532"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#252532"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#34344A"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,3"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО"
                            Binding="{Binding FullName}"
                            Width="220"/>

                            <DataGridTextColumn Header="Возраст"
                            Binding="{Binding Age}"
                            Width="80"/>

                            <DataGridTextColumn Header="Гражданство"
                            Binding="{Binding Citizenship}"
                            Width="130"/>

                            <DataGridTextColumn Header="Город"
                            Binding="{Binding Residence}"
                            Width="150"/>

                            <DataGridTextColumn Header="Статья"
                            Binding="{Binding ArticleNumber}"
                            Width="90"/>

                            <DataGridTextColumn Header="Срок"
                            Binding="{Binding SentenceTerm}"
                            Width="80"/>

                            <DataGridTextColumn Header="Отряд"
                            Binding="{Binding Unit}"
                            Width="80"/>

                            <DataGridTextColumn Header="Риск"
                    Binding="{Binding Risk}"
                    Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource BgCardColor}"
                    CornerRadius="6"
                    Padding="10"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1">
                <Grid>

                    <StackPanel Visibility="{Binding PrisonerVisibility}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="420">

                        <TextBlock Text="Режим заключённого"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Введите свой ID и перейдите к тестированию."
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="ID"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding SearchId, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Margin="0,0,0,15"
                                 BorderBrush="{StaticResource AccentColor}"
                                 BorderThickness="1"/>

                        <Button Content="Перейти к тестированию"
                                Command="{Binding PrisonerStartTestCommand}"
                                Height="42"
                                Background="{StaticResource AccentColor}"
                                BorderBrush="Transparent"/>
                    </StackPanel>

                    <TabControl Margin="10"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="{Binding PsychologistVisibility}">

                        <!-- Личные -->
                        <TabItem Header="Личные" Visibility="{Binding PsychologistVisibility}">
                            <StackPanel Margin="10">

                                <TextBlock Text="ФИО" Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}"
                                     Text="{Binding ParticipantVm.CurrentParticipant.FullName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Пол" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.Genders}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.Gender, Mode=TwoWay}"/>

                                <TextBlock Text="Дата рождения" Style="{StaticResource SectionHeader}"/>
                                <DatePicker SelectedDate="{Binding ParticipantVm.CurrentParticipant.BirthDate, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,3"
                                        Height="32">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#2B2B3A"/>
                                            <Setter Property="BorderThickness" Value="0"/>

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DatePickerTextBox">
                                                        <TextBox
                            Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType=DatePicker}, StringFormat=d}"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderThickness="0"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>

                                <TextBlock Text="Возраст (полных лет)" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding ParticipantVm.CurrentParticipant.Age, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Margin="0,3"
                                     Padding="6,0"
                                     Height="32"
                                     Background="#FF2B2B3A"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"/>

                                <TextBlock Text="Гражданство" Style="{StaticResource SectionHeader}"/>

                                <ComboBox Margin="0,3"
          Height="32"
          Style="{StaticResource DarkComboBox}"
          ItemsSource="{Binding ParticipantVm.Citizenships}"
          SelectedItem="{Binding ParticipantVm.CurrentParticipant.Citizenship, Mode=TwoWay}"/>


                                <TextBlock Text="Место рождения (регион)" Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}"
                                     Text="{Binding ParticipantVm.CurrentParticipant.BirthPlace, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Место проживания (населенный пункт)" Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}"
                            Text="{Binding ParticipantVm.CurrentParticipant.Residence, UpdateSourceTrigger=PropertyChanged}"/>



                                <TextBlock Text="Национальность" Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}"
                                     Text="{Binding ParticipantVm.CurrentParticipant.Nationality, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>


                                <TextBlock Text="Воспитывались ли Вы в полной семье?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.FamilyUpbringings}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.FamilyUpbringing}"/>

                                <TextBlock Text="Семейное положение" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.MaritalStatuses}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.MaritalStatus}"/>

                                <TextBlock Text="Имеются ли у Вас близкие родственники?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.YesNoValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.HasCloseRelatives}"/>

                                <TextBlock Text="Имеются ли у Вас дети? Сколько?" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="100"
                                          Margin="0,3,6,3"
                                          Height="32"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ParticipantVm.ChildrenPresenceValues}"
                                          SelectedItem="{Binding ParticipantVm.CurrentParticipant.HasChildren}"/>
                                    <TextBox Width="80"
                                         Height="32"
                                         Style="{StaticResource ValidatedTextBox}"
                                         Text="{Binding ParticipantVm.CurrentParticipant.ChildrenCount, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Text="Поддерживаете ли (намерены поддерживать) связь с родственниками в местах изоляции?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.YesNoValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.WillKeepContact}"/>

                                <TextBlock Text="Образование" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.EducationValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.EducationLevel}"/>

                                <TextBlock Text="Имеете ли Вы профессию?" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="100"
                                          Margin="0,3,6,3"
                                          Height="32"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ParticipantVm.ProfessionPresenceValues}"
                                          SelectedItem="{Binding ParticipantVm.CurrentParticipant.HasProfession}"/>
                                    <TextBox Width="200"
                                         Height="32"
                                         Style="{StaticResource ValidatedTextBox}"
                                         Text="{Binding ParticipantVm.CurrentParticipant.Profession, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Text="Ваше вероисповедание" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.ReligionValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.Religion}"/>

                            </StackPanel>
                        </TabItem>

                        <!-- Социальные -->
                        <TabItem Header="Социальные" Visibility="{Binding PsychologistVisibility}">
                            <StackPanel Margin="10">

                                <TextBlock Text="Служба в армии" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="100"
                                          Margin="0,3,6,3"
                                          Height="32"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ParticipantVm.ArmyServiceValues}"
                                          SelectedItem="{Binding ParticipantVm.CurrentParticipant.ArmyService}"/>
                                    <TextBox Width="200"
                                         Height="32"
                                         Style="{StaticResource ValidatedTextBox}"
                                         Text="{Binding ParticipantVm.CurrentParticipant.ArmyBranch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Род войск"/>
                                </StackPanel>

                                <TextBlock Text="Участие в боевых действиях" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.CombatParticipationValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.CombatParticipation}"/>

                                <TextBlock Text="Наличие тяжёлых соматических заболеваний" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.SomaticDiseasesValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.SomaticDiseases}"/>

                                <TextBlock Text="Наличие инвалидности" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.DisabilityValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.Disability}"/>

                                <TextBlock Text="Наличие психических заболеваний" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.MentalDiseasesValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.MentalDiseases}"/>

                                <TextBlock Text="Состояли ли Вы на учете у врача-психиатра?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.PsychiatristRegistryValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.PsychiatristRegistry}"/>

                                <TextBlock Text="Принимали ли Вы участие в азартных играх (тотализаторах)?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.GamblingValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.Gambling}"/>

                                <TextBlock Text="Имеете ли Вы обязательства?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.ObligationsValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.Obligations}"/>

                                <TextBlock Text="Состояли ли Вы на учете у врача-нарколога?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.NarcologistRegistryValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.NarcologistRegistry}"/>

                                <TextBlock Text="Употребляли ли Вы наркотические средства?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                                      Height="32"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding ParticipantVm.DrugUseValues}"
                                      SelectedItem="{Binding ParticipantVm.CurrentParticipant.DrugUse}"/>

                            </StackPanel>
                        </TabItem>

                        <!-- Криминальные -->
                        <TabItem Header="Криминальные" Visibility="{Binding PsychologistVisibility}">
                            <StackPanel Margin="10">

                                <TextBlock Text="Статья УК РФ" Style="{StaticResource SectionHeader}"/>

                                <DockPanel Margin="0,5,0,5">

                                    <StackPanel>

    <!-- статья -->
    <TextBlock Text="Статья"
               Foreground="{StaticResource TextSecondaryColor}"
               Margin="0,0,0,3"/>

    <ComboBox Height="32"
              Margin="0,0,0,8"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding Articles}"
              Text="{Binding FilterArticle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="True"
              IsTextSearchEnabled="True"
              StaysOpenOnEdit="True"/>

    <!-- часть -->
    <TextBlock Text="Часть"
               Foreground="{StaticResource TextSecondaryColor}"
               Margin="0,0,0,3"/>

    <ComboBox Height="32"
              Margin="0,0,0,8"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding ArticleParts}"
              SelectedItem="{Binding FilterArticlePart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>

    <!-- пункт -->
    <TextBlock Text="Пункт"
               Foreground="{StaticResource TextSecondaryColor}"
               Margin="0,0,0,3"/>

    <ComboBox Height="32"
              Margin="0,0,0,5"
              Style="{StaticResource DarkComboBox}"
              ItemsSource="{Binding ArticlePoints}"
              SelectedItem="{Binding FilterArticlePoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="False"/>

</StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding ArticleTooltipText}"
                   Foreground="#FF87AFFF"
                   TextWrapping="Wrap"
                   Margin="0,5,0,10"
                   FontWeight="SemiBold"/>

                                <TextBlock Text="Срок (лет)" Style="{StaticResource SectionHeader}"/>

                                <TextBox Style="{StaticResource ValidatedTextBox}"
                 Height="32"
                 Text="{Binding ParticipantVm.CurrentParticipant.SentenceTerm, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Margin="0,5"/>

                                <TextBlock Text="{Binding ParticipantVm.CurrentParticipant.SentenceTermDisplay}"
                   Foreground="#FF87AFFF"
                   FontWeight="Bold"
                   Margin="0,5"/>

                                <TextBlock Text="Какие Вы испытываете чувства в настоящее время?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ParticipantVm.CurrentFeelingsValues}"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.CurrentFeelings}"/>

                                <TextBlock Text="Что Вы думаете о своем нынешнем пребывании в УИС?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ParticipantVm.AttitudeToUISValues}"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.AttitudeToUIS}"/>

                                <TextBlock Text="Предпринимали ли Вы попытки суицида?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ParticipantVm.SuicideAttemptsValues}"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.SuicideAttempts}"/>

                                <TextBlock Text="Есть ли у Вас шрамы от самопорезов?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ParticipantVm.SelfHarmScarsValues}"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.SelfHarmScars}"/>

                                <TextBlock Text="Совершали ли Ваши близкие родственники суициды/попытки суицидов?" Style="{StaticResource SectionHeader}"/>
                                <ComboBox Margin="0,3"
                  Height="32"
                  Style="{StaticResource DarkComboBox}"
                  ItemsSource="{Binding ParticipantVm.RelativesSuicideValues}"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.RelativesSuicide}"/>

                                <TextBlock Text="Тип преступления" Style="{StaticResource SectionHeader}"/>
                                <ComboBox ItemsSource="{Binding CrimeTypes}"
                  Style="{StaticResource DarkComboBox}"
                  Height="32"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.CrimeType, Mode=TwoWay}"
                  Margin="0,5"/>

                                <TextBlock Text="Рецидив" Style="{StaticResource SectionHeader}"/>
                                <ComboBox ItemsSource="{Binding Recidivisms}"
                  Style="{StaticResource DarkComboBox}"
                  Height="32"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.Recidivism, Mode=TwoWay}"
                  Margin="0,5"/>

                                <TextBlock Text="Отряд" Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource ValidatedTextBox}"
                 Height="32"
                 Text="{Binding ParticipantVm.CurrentParticipant.Unit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Margin="0,5"/>

                                <TextBlock Text="Категория" Style="{StaticResource SectionHeader}"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                  Style="{StaticResource DarkComboBox}"
                  Height="32"
                  SelectedItem="{Binding ParticipantVm.CurrentParticipant.Category, Mode=TwoWay}"
                  Margin="0,5"/>

                            </StackPanel>
                        </TabItem>



                        <!-- Тестирование -->
                        <TabItem Header="Тестирование"
         Margin="0,0,8,0"
         Visibility="{Binding PsychologistVisibility}">

                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок + кнопка отчета -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                       Text="Пройденные тесты"
                       Foreground="{StaticResource TextPrimaryColor}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                    Content="Выгрузить отчет в PDF"
                    Command="{Binding ExportPdfCommand}"
                    Width="170"
                    Height="32"
                    Margin="10,0,0,0"
                    Background="{StaticResource AccentColor}"
                    BorderBrush="Transparent"/>
                                </Grid>

                                <!-- Блок риска по отряду -->
                                <Border Grid.Row="1"
                Background="#2A2A40"
                Padding="10"
                CornerRadius="8"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">

                                    <StackPanel>
                                        <TextBlock Text="Риск по отряду"
                           Foreground="{StaticResource TextPrimaryColor}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                                        <TextBlock Text="{Binding UnitRisk}"
                           Foreground="{Binding UnitRiskColor}"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                                        <TextBlock Text="{Binding UnitStats}"
                           Foreground="{StaticResource TextSecondaryColor}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Таблица пройденных тестов -->
                                <DataGrid Grid.Row="2"
                  ItemsSource="{Binding TestHistory}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  GridLinesVisibility="None"
                  Background="{StaticResource BgCardColor}"
                  Foreground="{StaticResource TextPrimaryColor}"
                  BorderBrush="{StaticResource BorderColor}"
                  AlternatingRowBackground="#FF2A2A38"
                  AlternationCount="2">

                                    <DataGrid.Resources>
                                        <Style x:Key="CenterCellText" TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#FF2B2B3A"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>

                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF2F2F40"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,0"/>

                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тест"
                                    Binding="{Binding TestName}"
                                    Width="*"
                                    ElementStyle="{StaticResource CenterCellText}"/>

                                        <DataGridTextColumn Header="Баллы"
                                    Binding="{Binding Score}"
                                    Width="80"
                                    ElementStyle="{StaticResource CenterCellText}"/>

                                        <DataGridTextColumn Header="Риск"
                                    Binding="{Binding Risk}"
                                    Width="120"
                                    ElementStyle="{StaticResource CenterCellText}"/>

                                        <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date}"
                                    Width="150"
                                    ElementStyle="{StaticResource CenterCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Аналитика -->
                        <TabItem Header="Аналитика" Visibility="{Binding PsychologistVisibility}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">

                                    <TextBlock Text="Аналитика"
                       Style="{StaticResource HeaderTextStyle}"/>

                                    <ComboBox ItemsSource="{Binding AnalyticsSections}"
          SelectedItem="{Binding SelectedAnalyticsSection, Mode=TwoWay}"
          Style="{StaticResource DarkComboBox}"
          Width="260"
          Height="32"
          Margin="0,0,0,15">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>


                                    <!-- ================= ПЕРСОНАЛЬНАЯ АНАЛИТИКА ================= -->
                                    <StackPanel Visibility="{Binding IsPersonalAnalyticsVisible}">

                                        <!-- КРАТКАЯ ИНФОРМАЦИЯ -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <Grid Margin="10">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Краткая информация"
                       Style="{StaticResource CardTitleStyle}"
                       Margin="0,0,0,10"/>

                                                <!-- ФИО -->
                                                <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="ФИО:"
                       Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding Current.FullName}"
                       Foreground="{StaticResource TextPrimaryColor}"/>

                                                <!-- ID -->
                                                <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="ID:"
                       Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding Current.PrisonerId}"
                       Foreground="{StaticResource TextPrimaryColor}"/>

                                                <!-- Отряд -->
                                                <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Отряд:"
                       Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding Current.Unit}"
                       Foreground="{StaticResource TextPrimaryColor}"/>

                                                <!-- Статья -->
                                                <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="Статья:"
                       Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1"
                       Text="{Binding Current.ArticleNumber}"
                       Foreground="{StaticResource TextPrimaryColor}"/>

                                                <!-- Категория -->
                                                <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="Категория:"
                       Foreground="{StaticResource TextSecondaryColor}"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1"
                       Text="{Binding Current.Category}"
                       Foreground="{StaticResource TextPrimaryColor}"/>

                                            </Grid>
                                        </Border>

                                        <!-- ДИНАМИКА РИСКА -->
                                        <Border Style="{StaticResource CardStyle}"
        MaxWidth="980"
        HorizontalAlignment="Left">

                                            <StackPanel>
                                                <TextBlock Text="Динамика по тестам"
                   Style="{StaticResource CardTitleStyle}"/>

                                                <lvc:CartesianChart Height="280"
                            Width="720"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Series="{Binding PersonalRiskSeries}"
                            XAxes="{Binding DateXAxis}"
                            YAxes="{Binding PersonalYAxis}"
                            LegendPosition="Right"
                            LegendTextPaint="{Binding PersonalLegendTextPaint}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Прогноз и заключение"
                   Style="{StaticResource CardTitleStyle}"/>

                                                <TextBlock Text="{Binding PersonalAiConclusion}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryColor}"
                   Margin="0,6,0,10"/>

                                                <TextBlock Text="{Binding PersonalAiRisk}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryColor}"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                                                <TextBlock Text="{Binding PersonalAiRecommendations}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ИСТОРИЯ ТЕСТОВ -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="История тестов"
                   Style="{StaticResource CardTitleStyle}"/>

                                                <Expander Header="Агрессивность"
                  Margin="0,6,0,6"
                  Foreground="{StaticResource TextPrimaryColor}"
                  Background="{StaticResource BgCardColor}"
                  Visibility="{Binding AggressionHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding AggressionHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="0,0,0,1"
                                Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Импульсивность"
                  Margin="0,6,0,6"
                  Foreground="{StaticResource TextPrimaryColor}"
                  Background="{StaticResource BgCardColor}"
                  Visibility="{Binding ImpulsivityHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding ImpulsivityHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Депрессия" Margin="0,6,0,6" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding DepressionHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding DepressionHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Стрессоустойчивость" Margin="0,6,0,6" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding StressHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding StressHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Адаптация" Margin="0,6,0,6" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding AdaptationHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding AdaptationHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Тревожность" Margin="0,6,0,6" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding AnxietyHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding AnxietyHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Устойчивость" Margin="0,6,0,6" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding ResilienceHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding ResilienceHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                                <Expander Header="Враждебность" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryColor}" Background="{StaticResource BgCardColor}" Visibility="{Binding HostilityHistory.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <ItemsControl ItemsSource="{Binding HostilityHistory}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Score, StringFormat=Баллы: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Risk, StringFormat=Риск: {0}}" Foreground="{StaticResource TextPrimaryColor}"/>
                                                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0}}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- АНАЛИТИКА ПО ОТРЯДАМ -->
                                    <StackPanel Visibility="{Binding IsUnitAnalyticsVisible}">

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Распределение риска"
                       Style="{StaticResource CardTitleStyle}"/>

                                                <TextBlock Text="Диаграмма отражает общее распределение участников по уровням риска (низкий, средний, высокий) на основе квартальных результатов психологической диагностики. Она позволяет оценить текущую психологическую обстановку в группе. Преобладание высокого уровня риска указывает на неблагоприятную ситуацию и необходимость усиленного контроля и профилактических мероприятий. Сбалансированное распределение свидетельствует о стабильном состоянии контингента."
                                                       TextWrapping="Wrap"
                                                       Opacity="0.7"
                                                       FontSize="12"
                                                       Margin="0,6,0,10"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>

                                                <Grid Margin="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>


                                                    <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center">


                                                        <lvc:PieChart Series="{Binding RiskDistributionSeries}"
                                  Width="260"
                                  Height="260"
                                  LegendPosition="Right">


                                                            <lvc:PieChart.LegendTextPaint>
                                                                <paint:SolidColorPaint Color="{x:Static skia:SKColors.White}"/>
                                                            </lvc:PieChart.LegendTextPaint>

                                                        </lvc:PieChart>

                                                        <ComboBox ItemsSource="{Binding Units}"
                              Style="{StaticResource DarkComboBox}"
                              Height="32"
                              Width="220"
                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                              Margin="0,10,0,10"/>

                                                        <TextBlock Text="{Binding UnitStats}"
                               Foreground="{StaticResource TextPrimaryColor}"
                               FontSize="13"
                               Margin="0,0,0,4"
                               HorizontalAlignment="Center"/>

                                                        <TextBlock Text="{Binding UnitRisk}"
                               Foreground="{StaticResource TextPrimaryColor}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                        Background="{StaticResource BgCardColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        Padding="12">

                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <StackPanel>

                                                                <TextBlock Text="Низкий риск:"
Foreground="#B7F200"
FontSize="14"
FontWeight="Bold"
Margin="0,0,0,6"/>

                                                                <ItemsControl ItemsSource="{Binding LowRiskPeople}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="0,0,0,3"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <TextBlock Text="Средний риск:"
Foreground="#35D2AB"
FontSize="14"
FontWeight="Bold"
Margin="0,12,0,6"/>

                                                                <ItemsControl ItemsSource="{Binding MediumRiskPeople}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="0,0,0,3"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <TextBlock Text="Высокий риск:"
Foreground="#FF1755"
FontSize="14"
FontWeight="Bold"
Margin="0,12,0,6"/>

                                                                <ItemsControl ItemsSource="{Binding HighRiskPeople}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   Margin="0,0,0,3"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <!-- ОБЩАЯ АНАЛИТИКА -->
                                    <StackPanel Visibility="{Binding IsGeneralAnalyticsVisible}">

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Риск по отрядам"
               Style="{StaticResource CardTitleStyle}"/>

                                                <TextBlock Text="Диаграмма отображает распределение уровней риска по отдельным отрядам и позволяет выявить группы с наиболее выраженными проблемами. Высокие значения риска в конкретных отрядах свидетельствуют о возможных неблагоприятных психологических условиях, требующих внимания специалистов. Низкие показатели указывают на более стабильную обстановку."
               TextWrapping="Wrap"
               Opacity="0.7"
               FontSize="12"
               Margin="0,6,0,10"
               Foreground="{StaticResource TextPrimaryColor}"/>

                                                <lvc:CartesianChart Height="250"
                        Series="{Binding RiskByUnitSeries}"
                        XAxes="{Binding UnitXAxis}"
                        YAxes="{Binding RiskYAxis}"/>

                                                <TextBlock Text="{Binding RiskByUnitsInfo}"
               TextWrapping="Wrap"
               FontSize="12"
               Margin="0,8,0,0"
               Opacity="0.85"
               Foreground="{StaticResource TextPrimaryColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Первоходы vs Второходы"
   Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock Text="Диаграмма показывает различия в уровне риска между первично осуждёнными и лицами, имеющими повторные судимости. Сравнительный анализ позволяет выявить влияние криминального опыта на психологическое состояние и использовать эти данные для разработки более точных мер психологического сопровождения."
                                                       TextWrapping="Wrap"
                                                       Opacity="0.7"
                                                       FontSize="12"
                                                       Margin="0,6,0,10"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                                <lvc:CartesianChart Height="260"
            Series="{Binding RecidivismSeries}"
            XAxes="{Binding RecidivismXAxis}"
            YAxes="{Binding RiskYAxis}"/>
                                                
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="ТОП отряды по улучшению"
   Style="{StaticResource CardTitleStyle}"/>
                                                <TextBlock Text="Диаграмма отражает отряды, в которых наблюдается наибольшее улучшение психологических показателей за определённый период. Снижение негативных характеристик и рост позитивных показателей свидетельствуют об эффективности проводимой работы. Такой анализ помогает выявлять успешные практики и применять их в других подразделениях."
                                                       TextWrapping="Wrap"
                                                       Opacity="0.7"
                                                       FontSize="12"
                                                       Margin="0,6,0,10"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                                <lvc:CartesianChart Height="260"
            Series="{Binding TopUnitsSeries}"
            XAxes="{Binding TopUnitsXAxis}"
            YAxes="{Binding RiskYAxis}"/>
                                                <ListBox ItemsSource="{Binding TopPeople}"
 Background="Transparent"
 Foreground="White"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>