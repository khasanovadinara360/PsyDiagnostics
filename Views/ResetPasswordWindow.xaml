<Window x:Class="PsyDiagnostics.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Width="420"
        Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E28">

    <Border Padding="25"
            Background="#252532"
            BorderBrush="#323244"
            BorderThickness="1">

        <StackPanel>

            <TextBlock Text="Смена пароля"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Введите новый пароль"
                       Foreground="#9FA4B5"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Height="38"
                         Padding="10,0"
                         Background="#1E1E28"
                         Foreground="White"
                         BorderBrush="#323244"/>

            <TextBlock Text="Минимум 8 символов, заглавная буква, цифра и спецсимвол"
                       Foreground="#9FA4B5"
                       FontSize="11"
                       Margin="0,8,0,18"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Отмена"
                        Width="100"
                        Height="36"
                        Background="#323244"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Сменить"
                        Width="100"
                        Height="36"
                        Background="#4E5DFF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Save_Click"/>

            </StackPanel>

        </StackPanel>

    </Border>
</Window>