<UserControl x:Class="PsyDiagnostics.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C40"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Width" Value="400"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsSelected}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#3A3A60"/>

                    <Setter Property="BorderBrush"
                            Value="#6A6AC0"/>
                </DataTrigger>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#353550"/>

                    <Setter Property="BorderBrush"
                            Value="#5A5AC0"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="BottomButtonStyle"
               TargetType="Button">

            <Setter Property="Padding"
                    Value="18,8"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#1E1E2F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0"
                    Margin="10">

            <TextBlock Text="{Binding TestTitle}"
                       FontSize="20"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding ModeTitle}"
                       Margin="0,2,0,6"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

            <ProgressBar Maximum="{Binding TotalQuestions}"
                         Value="{Binding CurrentIndex, Mode=OneWay}"
                         Height="10"
                         Margin="0,5"/>
        </StackPanel>

        <!-- Question -->

        <StackPanel Grid.Row="1"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

            <TextBlock Text="{Binding QuestionNumber}"
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding CurrentQuestion.Text}"
                       Margin="0,10,0,20"
                       FontSize="20"
                       Foreground="White"
                       TextWrapping="Wrap"
                       MaxWidth="600"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Answers -->

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding CurrentQuestion.Answers}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Button Content="{Binding Text}"
                            Command="{Binding SelectAnswerCommand}"
                            Style="{StaticResource AnswerButtonStyle}"/>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- Bottom Buttons -->

        <DockPanel Grid.Row="2"
                   Margin="10"
                   LastChildFill="False">

            <Button Content="На главную"
                    DockPanel.Dock="Left"
                    Background="#2C2C40"
                    BorderBrush="#4A4A6A"
                    Command="{Binding DataContext.GoHomeCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}">

                <Button.Style>

                    <Style TargetType="Button"
                           BasedOn="{StaticResource BottomButtonStyle}">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding DataContext.CanGoHomeAfterTests,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#3A3A60"/>

                                <Setter Property="BorderBrush"
                                        Value="#6A6AC0"/>
                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Button.Style>

            </Button>

            <Button Content="Завершить"
                    DockPanel.Dock="Right"
                    Background="#4060C0"
                    BorderBrush="#4060C0"
                    Visibility="{Binding FinishButtonVisibility}"
                    Command="{Binding FinishCommand}"
                    Style="{StaticResource BottomButtonStyle}"/>

        </DockPanel>

    </Grid>

</UserControl>