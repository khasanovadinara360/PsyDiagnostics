<UserControl x:Class="PsyDiagnostics.Views.MultiTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PsyDiagnostics.ViewModels"
             xmlns:views="clr-namespace:PsyDiagnostics.Views">

    <UserControl.Resources>
        <Style x:Key="TestListButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C40"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HomeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C40"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CanGoHomeAfterTests,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:TestViewModel}">
            <views:TestView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#1E1E2F">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#232336">

                <ListBox ItemsSource="{Binding TestViewModels}"
                         SelectedItem="{Binding CurrentTest}"
                         Margin="5"
                         Background="Transparent"
                         BorderThickness="0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding TestTitleWithCheck}"
                                    Command="{Binding DataContext.SelectTestCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource TestListButtonStyle}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentTest}"/>
        </Grid>

        <DockPanel Grid.Row="1"
                   Margin="10"
                   LastChildFill="False">

            <Button Content="На главную"
                    DockPanel.Dock="Left"
                    Command="{Binding DataContext.GoHomeCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource HomeButtonStyle}"/>
        </DockPanel>
    </Grid>
</UserControl>