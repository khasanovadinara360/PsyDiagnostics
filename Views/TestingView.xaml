<UserControl x:Class="PsyDiagnostics.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<Style x:Key="ActionButtonStyle" TargetType="Button">
			<Setter Property="Padding" Value="15,8"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#2C2C40"/>
			<Setter Property="BorderBrush" Value="#4A4A6A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</UserControl.Resources>

	<Grid Margin="10" Background="#1E1E2F">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="Тестирование"
                   Margin="0,0,0,10"
                   Foreground="White"
                   FontSize="20"/>

		<DataGrid Grid.Row="1"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="0,0,0,10">

			<DataGrid.Columns>
				<DataGridTextColumn Header="Тест"
                                    Binding="{Binding TestName}"
                                    Width="*"/>

				<DataGridTextColumn Header="Баллы"
                                    Binding="{Binding Score}"
                                    Width="80"/>

				<DataGridTextColumn Header="Риск"
                                    Binding="{Binding Risk}"
                                    Width="120"/>

				<DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date}"
                                    Width="150"/>
			</DataGrid.Columns>
		</DataGrid>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

			<Button Content="Выгрузить отчет в PDF"
                    Command="{Binding ExportPdfCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
		</StackPanel>
	</Grid>
</UserControl>