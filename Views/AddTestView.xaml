<UserControl x:Class="PsyDiagnostics.Views.AddTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgMainColor" Color="#FF1E1E28"/>
        <SolidColorBrush x:Key="BgCardColor" Color="#FF252532"/>
        <SolidColorBrush x:Key="CardColor" Color="#FF2A2A40"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF323244"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF4E5DFF"/>
        <SolidColorBrush x:Key="DangerColor" Color="#FFB63A3A"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#FF9FA4B5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BgCardColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardColor}"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgMainColor}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Добавление нового теста"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Название теста"/>
                    <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Количество вопросов"/>
                    <TextBox Text="{Binding QuestionsCountText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Текст вопроса" FontWeight="SemiBold"/>

                    <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Margin="0,5,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ответ"
                                   Foreground="{StaticResource TextSecondaryColor}"/>

                        <TextBlock Grid.Column="1"
                                   Text="Баллы"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Answer1Text, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Answer1ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Answer2Text, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Answer2ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding Answer3Text, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Answer3ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0,0,0"/>
                    </Grid>

                    <Button Content="Добавить вопрос"
                            Command="{Binding AddQuestionCommand}"
                            Height="36"
                            Margin="0,18,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Добавленные вопросы"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="Сохранить вопрос"
                                Command="{Binding SaveQuestionChangesCommand}"
                                Width="145"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Удалить вопрос"
                                Command="{Binding DeleteQuestionCommand}"
                                Width="120"
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding QuestionsPreview}"
                             SelectedItem="{Binding SelectedAddedQuestion, Mode=TwoWay}"
                             MaxHeight="430"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditQuestionCommand}"/>
                        </ListBox.InputBindings>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Существующие тесты"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ExistingTests}"
                             SelectedItem="{Binding SelectedExistingTest, Mode=TwoWay}"/>

                    <Button Grid.Row="2"
                            Content="Удалить тест"
                            Command="{Binding DeleteTestCommand}"
                            Height="36"
                            Margin="0,12,0,0"
                            Style="{StaticResource DangerButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    Width="120"
                    Height="38"
                    Margin="0,0,10,0"/>

            <Button Content="Сохранить тест"
                    Command="{Binding SaveTestCommand}"
                    Width="160"
                    Height="38"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>