<UserControl x:Class="PsyDiagnostics.Views.AddTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#1E1E28" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Добавление нового теста"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#2A2A40"
                Padding="15"
                CornerRadius="8"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Название теста" Foreground="White"/>
                <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,5,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="280">
                        <TextBlock Text="Максимум низкого уровня" Foreground="White"/>
                        <TextBox Text="{Binding LowMaxText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Width="280" Margin="20,0,0,0">
                        <TextBlock Text="Максимум среднего уровня" Foreground="White"/>
                        <TextBox Text="{Binding MediumMaxText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#2A2A40"
                    Padding="15"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Текст вопроса" Foreground="White"/>
                    <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Ответы" Foreground="White"/>

                    <TextBlock Text="Ответ 1" Foreground="#9FA4B5" Margin="0,8,0,2"/>
                    <DockPanel>
                        <TextBox Text="{Binding Answer1Text, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding Answer1ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70"
                                 Height="32"
                                 Margin="10,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="Ответ 2" Foreground="#9FA4B5" Margin="0,8,0,2"/>
                    <DockPanel>
                        <TextBox Text="{Binding Answer2Text, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding Answer2ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70"
                                 Height="32"
                                 Margin="10,0,0,0"/>
                    </DockPanel>

                    <TextBlock Text="Ответ 3" Foreground="#9FA4B5" Margin="0,8,0,2"/>
                    <DockPanel>
                        <TextBox Text="{Binding Answer3Text, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding Answer3ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70"
                                 Height="32"
                                 Margin="10,0,0,0"/>
                    </DockPanel>

                    <Button Content="Добавить вопрос"
                            Command="{Binding AddQuestionCommand}"
                            Height="36"
                            Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#2A2A40"
                    Padding="15"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Добавленные вопросы"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding QuestionsPreview}"
                             Background="#252532"
                             Foreground="White"
                             BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Назад"
                    Command="{Binding BackCommand}"
                    Width="120"
                    Height="38"
                    Margin="0,0,10,0"/>

            <Button Content="Сохранить тест"
                    Command="{Binding SaveTestCommand}"
                    Width="160"
                    Height="38"
                    Background="#4E5DFF"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>