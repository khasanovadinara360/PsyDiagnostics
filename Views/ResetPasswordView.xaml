<UserControl x:Class="PsyDiagnostics.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E28">

    <Border Padding="25"
            Background="#252532"
            BorderBrush="#323244"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="Изменение пароля"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Введите новый пароль"
                       Foreground="#9FA4B5"
                       Margin="0,0,0,6"/>
            <Grid>

                <PasswordBox x:Name="NewPasswordBox"
                             Height="38"
                             Padding="10,0,40,0"
                             Background="#1E1E28"
                             Foreground="White"
                             BorderBrush="#323244"/>

                <TextBox x:Name="NewPasswordTextBox"
                         Height="38"
                         Padding="10,0,40,0"
                         Background="#1E1E28"
                         Foreground="White"
                         BorderBrush="#323244"
                         Visibility="Collapsed"/>

                <Button Width="34"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="TogglePassword_Click">

                    <TextBlock x:Name="EyeIcon"
                               Text="👁"
                               FontSize="16"
                               Foreground="White"/>
                </Button>
            </Grid>

            <TextBlock Text="Минимум 8 символов, заглавная буква, цифра и спецсимвол"
                       Foreground="#9FA4B5"
                       FontSize="11"
                       Margin="0,8,0,6"/>

            <TextBlock x:Name="ResetPasswordErrorText"
                       Text=""
                       Foreground="#FFFF5370"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Отмена"
                        Width="100"
                        Height="36"
                        Background="#323244"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Сменить"
                        Width="100"
                        Height="36"
                        Background="#4E5DFF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>